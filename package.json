{
  "name": "comfy-agent",
  "version": "0.2.0",
  "type": "module",
  "description": "ComfyUI Prompt Agent - Desktop Edition",
  "main": "electron/main.mjs",
  "bin": {
    "comfy-agent": "src/cli.mjs"
  },
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && .\\node_modules\\electron\\dist\\electron.exe .\"",
    "build": "vite build",
    "pack": "vite build && electron-builder --win --config electron-builder.yml",
    "test": "node --test tests/*.test.mjs",
    "lint": "node scripts/lint.mjs",
    "agent": "node src/cli.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  }
}
